<mxfile host="app.diagrams.net"><diagram name="AML Alert Workflow"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="900" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;AML Alert Workflow, Prairie Trust Bank (fictional)&lt;/b&gt;" style="text;html=1;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="-30" width="500" height="30" as="geometry"/></mxCell><mxCell id="a" value="Nightly transaction and customer load" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="360" y="20" width="180" height="60" as="geometry"/></mxCell><mxCell id="b" value="Counts reconcile?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="370" y="110" width="160" height="90" as="geometry"/></mxCell><mxCell id="b1" value="IT investigates and reloads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="125" width="160" height="60" as="geometry"/></mxCell><mxCell id="c" value="Detection scenarios run on 100% of transactions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="240" width="180" height="60" as="geometry"/></mxCell><mxCell id="l" value="Cash $10,000+ in 24 hours?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="330" width="170" height="100" as="geometry"/></mxCell><mxCell id="l1" value="LCTR draft created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="95" y="470" width="160" height="60" as="geometry"/></mxCell><mxCell id="l2" value="Reporting officer files within 15 calendar days" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="95" y="570" width="160" height="70" as="geometry"/></mxCell><mxCell id="d" value="Scenario triggered?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="370" y="330" width="160" height="100" as="geometry"/></mxCell><mxCell id="z" value="No action. Retained 5 years" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="345" width="160" height="70" as="geometry"/></mxCell><mxCell id="e" value="Alert risk scored and queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="370" y="470" width="160" height="60" as="geometry"/></mxCell><mxCell id="f" value="Analyst investigates and documents rationale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="370" y="570" width="160" height="70" as="geometry"/></mxCell><mxCell id="g" value="Grounds to suspect ML/TF?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="365" y="680" width="170" height="110" as="geometry"/></mxCell><mxCell id="h" value="Analyst proposes closure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="705" width="160" height="60" as="geometry"/></mxCell><mxCell id="i" value="Team lead approves? (maker/checker)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="615" y="810" width="170" height="110" as="geometry"/></mxCell><mxCell id="j" value="Alert closed. Retained 5 years" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="960" width="160" height="70" as="geometry"/></mxCell><mxCell id="k" value="Escalate to STR case" style="rounded=1;whiteSpace=wrap;html